// /api/notify.js
//
// Combines what used to be three separate endpoints (notify-admin,
// notify-customer, notify-riders-new-delivery) into one, purely to stay
// under Vercel's 12-serverless-function limit on the free Hobby plan —
// deploys started failing once the project crossed that count.
//
// Pass { type: 'admin' | 'customer' | 'riders_new_delivery', ...payload }.
//
// NOTE: the old notify-admin.js had entirely wrong code in it — a stray
// duplicate of the payment-verification logic, not a notification
// function at all. Every "new vendor application" notice has silently
// failed until now. Fixed here as part of the merge.

const STATUS_MESSAGES = {
  rejected: {
    subject: "Your order couldn't be accepted",
    text: (code, reason) => `Unfortunately the store wasn't able to accept your order ${code}.${reason ? ` Reason given: ${reason}.` : ''} If you paid online, this has been refunded automatically.`,
  },
  preparing: {
    subject: 'Your order is being prepared',
    text: (code) => `Good news — your order ${code} has been accepted and is now being prepared.`,
  },
  ready: {
    subject: 'Your order is ready',
    text: (code) => `Your order ${code} is ready! If you chose pickup, you can collect it now with your pickup code.`,
  },
  out_for_delivery: {
    subject: 'A rider is on the way to pick up your order',
    text: (code) => `A Sultini rider has been assigned to your order ${code} and is heading to the store now.`,
  },
  picked_up: {
    subject: 'Your order is on its way to you',
    text: (code) => `Your rider has picked up order ${code} and is on the way to you now.`,
  },
  delivered: {
    subject: 'Your order has been delivered',
    text: (code) => `Order ${code} has been marked as delivered. Enjoy! If anything was wrong, you can report a problem from your account page.`,
  },
  completed: {
    subject: 'Thanks for picking up your order!',
    text: (code) => `Order ${code} has been confirmed picked up. Enjoy! If anything was wrong, you can report a problem from your account page.`,
  },
};

async function sendEmail(to, subject, text) {
  return fetch('https://api.resend.com/emails', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${process.env.RESEND_API_KEY}` },
    body: JSON.stringify({ from: 'Sultini Express <notifications@sultini.com>', to: [to], subject, text }),
  });
}

// Vendors and riders get SMS, not email — they're on the move and often
// don't check email. Admin and customers stay on email. Needs
// TERMII_API_KEY and an approved TERMII_SENDER_ID to actually send;
// until those are set, this fails loudly in the logs but never blocks
// the order/notification flow that called it.
async function sendSMS(phone, message) {
  const apiKey = process.env.TERMII_API_KEY;
  const senderId = process.env.TERMII_SENDER_ID || 'Sultini';
  if (!apiKey) {
    console.error('TERMII_API_KEY not set — SMS not sent to', phone);
    return { skipped: true, reason: 'no_api_key' };
  }
  const digits = (phone || '').replace(/\D/g, '');
  const intl = digits.startsWith('234') ? digits : '234' + digits.replace(/^0/, '');

  const res = await fetch('https://api.ng.termii.com/api/sms/send', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      to: intl, from: senderId, sms: message,
      type: 'plain', channel: 'generic', api_key: apiKey,
    }),
  });
  const data = await res.json();
  if (!res.ok) console.error('Termii SMS failed:', data);
  return data;
}

export default async function handler(req, res) {
  if (req.method !== 'POST') {
    return res.status(405).json({ error: 'Method not allowed' });
  }

  const { type } = req.body;
  const SUPABASE_URL = process.env.SUPABASE_URL;
  const SERVICE_KEY = process.env.SUPABASE_SERVICE_ROLE_KEY;
  const sbHeaders = { apikey: SERVICE_KEY, Authorization: `Bearer ${SERVICE_KEY}` };

  try {
    // ---- Admin notification: simple subject/message, e.g. new vendor application ----
    // ---- Welcome email: sent right after a new customer account is created ----
    if (type === 'welcome') {
      const { email, name } = req.body;
      if (!email) return res.status(400).json({ error: 'Missing email' });
      const firstName = (name || '').split(' ')[0] || 'there';
      await sendEmail(
        email,
        'Welcome to Sultini Express 🎉',
        `Hi ${firstName},\n\nWelcome to Sultini Express — Sokoto's food and pharmacy delivery platform. Your account is ready.\n\nBrowse local restaurants, grills, and pharmacies, order for delivery or pickup, and track your order in real time from the moment it's placed.\n\nReady when you are: sultini.com\n\n— The Sultini Express team`
      );
      return res.status(200).json({ success: true });
    }

    if (type === 'admin') {
      const { subject, message } = req.body;
      if (!subject || !message) return res.status(400).json({ error: 'Missing subject or message' });
      await sendEmail('sultiniexpress@yahoo.com', `Sultini Express: ${subject}`, message);
      return res.status(200).json({ success: true });
    }

    // ---- Customer notification: order status changed ----
    if (type === 'customer') {
      const { orderId, status } = req.body;
      if (!orderId || !status) return res.status(400).json({ error: 'Missing orderId or status' });

      const template = STATUS_MESSAGES[status];
      if (!template) return res.status(200).json({ skipped: true }); // not every status needs an email

      const orderRes = await fetch(`${SUPABASE_URL}/rest/v1/orders?id=eq.${orderId}&select=pickup_code,customer_email,rejection_reason`, { headers: sbHeaders });
      const orders = await orderRes.json();
      const order = orders && orders[0];
      if (!order || !order.customer_email) return res.status(200).json({ skipped: true, reason: 'No customer email on file' });

      await sendEmail(order.customer_email, `Sultini Express: ${template.subject}`, template.text(order.pickup_code, order.rejection_reason));
      return res.status(200).json({ success: true });
    }

    // ---- Vendor notification: new order came in — SMS, not email ----
    if (type === 'vendor') {
      const { vendorId, message } = req.body;
      if (!vendorId || !message) return res.status(400).json({ error: 'Missing vendorId or message' });

      const vendorRes = await fetch(`${SUPABASE_URL}/rest/v1/vendors?id=eq.${vendorId}&select=name,phone,managed_by_admin`, { headers: sbHeaders });
      const vendors = await vendorRes.json();
      const vendor = vendors && vendors[0];
      if (!vendor) return res.status(200).json({ skipped: true, reason: 'Vendor not found' });

      // Vendors you manage yourself have no dashboard of their own — the
      // order notification needs to reach you instead, not them, with
      // enough context to know which store it's actually for.
      if (vendor.managed_by_admin) {
        const adminMessage = `[${vendor.name}] ${message}`;
        const smsResult = await sendSMS('2347033580395', adminMessage);
        await sendEmail('sultiniexpress@yahoo.com', `Sultini: New order for ${vendor.name}`, adminMessage);
        return res.status(200).json({ success: true, routedToAdmin: true, smsResult });
      }

      if (!vendor.phone) return res.status(200).json({ skipped: true, reason: 'No phone number on file for this vendor' });
      const result = await sendSMS(vendor.phone, message);
      return res.status(200).json({ success: true, result });
    }

    // ---- Rider notification: new delivery available for anyone to claim — SMS, not email ----
    if (type === 'riders_new_delivery') {
      const { pickupCode } = req.body;
      if (!pickupCode) return res.status(400).json({ error: 'Missing pickupCode' });

      const ridersRes = await fetch(`${SUPABASE_URL}/rest/v1/riders?active=eq.true&select=phone`, { headers: sbHeaders });
      const riders = await ridersRes.json();
      const phones = (riders || []).map(r => r.phone).filter(Boolean);
      if (phones.length === 0) return res.status(200).json({ skipped: true, reason: 'No active riders with a phone on file' });

      await Promise.all(phones.map(phone =>
        sendSMS(phone, `New delivery available (order ${pickupCode}). Log into your Sultini rider dashboard to accept it.`)
          .catch(e => console.error('Failed to notify', phone, e))
      ));
      return res.status(200).json({ success: true, notified: phones.length });
    }

    return res.status(400).json({ error: `Unknown notification type: ${type}` });
  } catch (err) {
    console.error(err);
    return res.status(500).json({ error: 'Notification failed' });
  }
}
